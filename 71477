
  :root{
    --ink:#202028;--ink-soft:#33333d;--gold:#B89048;--gold-deep:#9a763a;
    --gold-tint:rgba(184,144,72,.12);--paper:#F2F0EB;--paper-2:#ECE9E2;
    --card:#FCFBF8;--line:rgba(32,32,40,.14);--line-soft:rgba(32,32,40,.08);--muted:#6b6970;
    --display:"Gelasio",Cambria,Georgia,"Times New Roman",serif;
    --body:"Carlito",Calibri,"Segoe UI",system-ui,sans-serif;--maxw:1080px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.62;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  ::selection{background:var(--gold);color:#fff}
  h1,h2,h3,h4{font-family:var(--display);font-weight:600;line-height:1.12;margin:0;color:var(--ink)}
  p{margin:0 0 1em}
  a{color:inherit}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 40px}
  .eyebrow{font-family:var(--body);font-weight:700;font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold-deep);display:flex;align-items:center;gap:14px}
  .eyebrow::before{content:"";width:34px;height:1px;background:var(--gold);display:inline-block}
  .lead{font-size:20px;line-height:1.55;color:var(--ink-soft)}
  .muted{color:var(--muted)}
  .hex{display:inline-block;vertical-align:middle}
  .hex svg{display:block}

  .cover{position:relative;background:var(--ink);color:#f4f2ec;overflow:hidden;padding:72px 0 0}
  .cover .wrap{position:relative;z-index:2}
  .cover-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:end;padding-bottom:52px}
  .brandline{display:flex;align-items:center;gap:16px;margin-bottom:64px}
  .brandline .name{font-family:var(--display);font-size:22px;letter-spacing:.16em;font-weight:600}
  .brandline .name b{color:var(--gold);font-weight:600}
  .cover .eyebrow{color:var(--gold)}
  .cover .eyebrow::before{background:var(--gold)}
  .cover h1{font-size:clamp(36px,5.4vw,62px);font-weight:600;letter-spacing:-.01em;margin:22px 0 24px;color:#fff}
  .cover h1 em{font-style:italic;color:var(--gold)}
  .cover .sub{font-size:19px;line-height:1.55;color:#cfccc4;max-width:40ch}
  .cover-side{padding-bottom:6px}
  .cover-hex{opacity:.9;margin-bottom:26px}
  .sectorstrip{border-top:1px solid rgba(255,255,255,.16);display:grid;grid-template-columns:repeat(4,1fr)}
  .sectorstrip div{padding:20px 0;border-right:1px solid rgba(255,255,255,.1)}
  .sectorstrip div:last-child{border-right:0}
  .sectorstrip .i{font-family:var(--display);font-size:12px;color:var(--gold);margin-bottom:6px}
  .sectorstrip .v{font-family:var(--display);font-size:15px;color:#efece5}
  .cover-rule{height:6px;background:linear-gradient(90deg,var(--gold) 0%,var(--gold-deep) 100%)}
  .cover-bg-hex{position:absolute;right:-140px;top:-80px;opacity:.05;z-index:1;pointer-events:none}

  section{padding:78px 0}
  .sec-head{max-width:62ch;margin-bottom:44px}
  .sec-head h2{font-size:clamp(26px,3.4vw,38px);margin:18px 0 0}
  .sec-head .lead{margin-top:18px}
  .dark{background:var(--ink);color:#e9e6df}
  .dark h2,.dark h3,.dark h4{color:#fff}
  .dark .eyebrow{color:var(--gold)}
  .dark .muted{color:#a9a6a0}
  .dark .lead{color:#cbc8c1}

  .thesis{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
  .pullquote{font-family:var(--display);font-size:26px;line-height:1.4;font-weight:500;color:var(--ink);border-left:3px solid var(--gold);padding:6px 0 6px 28px}
  .pullquote b{color:var(--gold-deep);font-weight:600}

  /* sectors */
  .sector{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center;padding:52px 0;border-top:1px solid var(--line)}
  .sector:last-of-type{border-bottom:1px solid var(--line)}
  .sector.flip .sector-txt{order:2}
  .sector .idx{font-family:var(--display);font-size:14px;letter-spacing:.22em;color:var(--gold-deep);text-transform:uppercase;margin-bottom:14px}
  .sector h3{font-size:clamp(24px,3vw,32px);margin-bottom:14px}
  .sector p{font-size:16px;color:var(--ink-soft);margin:0 0 16px;max-width:52ch}
  .ticklist{list-style:none;padding:0;margin:14px 0 0}
  .ticklist li{position:relative;padding:0 0 11px 26px;font-size:15px;color:var(--ink-soft)}
  .ticklist li::before{content:"";position:absolute;left:0;top:8px;width:9px;height:9px;background:var(--gold);transform:rotate(45deg)}

  .imgframe{position:relative;background:linear-gradient(135deg,var(--paper-2) 0%,#e3e0d8 100%);border:1px solid var(--line);overflow:hidden;display:flex;align-items:flex-end}
  .imgframe::before{content:"";position:absolute;inset:0;background-image:radial-gradient(var(--line-soft) 1px,transparent 1px);background-size:22px 22px;opacity:.6}
  .imgframe .wm{position:absolute;top:20px;right:20px;opacity:.16}
  .imgframe .cap{position:relative;z-index:2;padding:18px 20px;width:100%;background:linear-gradient(0deg,rgba(32,32,40,.82),transparent);color:#f2efe8}
  .imgframe .cap .t{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:4px}
  .imgframe .cap .d{font-family:var(--display);font-size:15px;color:#fff;line-height:1.3}
  .ar-hero{aspect-ratio:4/3}.ar-wide{aspect-ratio:16/9}.ar-tall{aspect-ratio:3/4}.ar-sq{aspect-ratio:1/1}

  /* core services grid */
  .svc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line-soft);border:1px solid var(--line-soft)}
  .svc{background:var(--card);padding:30px 30px 32px;display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:start}
  .svc h3{font-size:19px;margin-bottom:8px}
  .svc p{font-size:14.5px;color:var(--muted);margin:0}
  .dark .svc{background:rgba(255,255,255,.03)}
  .dark .svc p{color:#b3b0aa}

  /* difference */
  .diff{display:grid;grid-template-columns:repeat(2,1fr);gap:34px 48px;margin-top:8px}
  .diff-item{display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:start}
  .diff-item h3{font-size:20px;margin-bottom:8px}
  .diff-item p{font-size:15.5px;margin:0;color:#c7c4bd}
  .diff .hex{margin-top:3px}

  /* lifecycle compact */
  .flow{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .flow-step{background:var(--card);border:1px solid var(--line-soft);padding:24px 22px;position:relative}
  .flow-step .n{font-family:var(--display);font-size:13px;color:var(--gold-deep);letter-spacing:.16em;margin-bottom:12px}
  .flow-step h3{font-size:17px;margin-bottom:8px}
  .flow-step p{font-size:14px;color:var(--muted);margin:0}

  /* ethics */
  .ethics{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center}
  .ethics-list{list-style:none;padding:0;margin:0}
  .ethics-list li{padding:22px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:start}
  .ethics-list li:last-child{border-bottom:1px solid var(--line)}
  .ethics-list h3{font-size:18px;margin-bottom:6px}
  .ethics-list p{font-size:15px;color:var(--muted);margin:0}
  .statute{font-size:12.5px;letter-spacing:.03em;color:var(--gold-deep);font-weight:700}

  /* models */
  .models{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line-soft);border:1px solid var(--line-soft)}
  .model{background:var(--card);padding:30px 28px}
  .model h3{font-size:19px;margin-bottom:10px}
  .model p{font-size:15px;color:var(--muted);margin:0}
  .fee{margin-top:30px;background:var(--ink);color:#e9e6df;padding:34px 36px;border-left:4px solid var(--gold)}
  .fee h3{color:#fff;font-size:20px;margin-bottom:12px}
  .fee p{font-size:15.5px;color:#c7c4bd;margin:0}
  .note-slot{margin-top:26px;border:1px dashed var(--gold);background:var(--gold-tint);padding:18px 22px;font-size:14.5px;color:var(--ink-soft);border-radius:2px}
  .note-slot b{color:var(--gold-deep)}

  /* cta */
  .cta{background:var(--ink);color:#fff}
  .cta-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:56px;align-items:center}
  .cta h2{font-size:clamp(28px,4vw,44px);margin-bottom:20px;color:#fff}
  .cta h2 em{color:var(--gold);font-style:italic}
  .cta .lead{color:#cbc8c1;max-width:44ch}
  .contact-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);padding:32px}
  .contact-card .row{padding:14px 0;border-bottom:1px solid rgba(255,255,255,.1);display:flex;justify-content:space-between;gap:16px;font-size:15px}
  .contact-card .row:last-child{border-bottom:0}
  .contact-card .k{color:var(--gold);font-size:11px;letter-spacing:.18em;text-transform:uppercase;align-self:center}
  .contact-card .v{color:#efece5;text-align:right;font-family:var(--display)}

  footer{background:#17171d;color:#8f8c86;padding:44px 0}
  .foot{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}
  .foot .fl{display:flex;align-items:center;gap:14px}
  .foot .fl .name{font-family:var(--display);color:#d8d5ce;letter-spacing:.14em}
  .foot .fl .name b{color:var(--gold)}
  .foot .fr{font-size:13px;max-width:52ch;line-height:1.6}

  @media (max-width:900px){
    body{font-size:16px}
    .wrap{padding:0 24px}
    section{padding:56px 0}
    .cover{padding-top:48px}
    .cover-grid,.thesis,.ethics,.cta-grid{grid-template-columns:1fr;gap:34px}
    .sector,.sector.flip{grid-template-columns:1fr;gap:26px}
    .sector.flip .sector-txt{order:0}
    .svc-grid,.models,.diff{grid-template-columns:1fr}
    .flow{grid-template-columns:1fr 1fr}
    .sectorstrip{grid-template-columns:1fr 1fr}
    .sectorstrip div{border-right:0;border-bottom:1px solid rgba(255,255,255,.1)}
    .brandline{margin-bottom:40px}
    .cover-bg-hex{display:none}
    .contact-card .v{text-align:left}
    .contact-card .row{flex-direction:column;gap:4px}
  }
  @media (max-width:560px){.flow{grid-template-columns:1fr}}
  @media (prefers-reduced-motion:no-preference){
    .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}
    .reveal.in{opacity:1;transform:none}
  }
  @media print{
    body{background:#fff}
    .cover,.dark,.cta{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    section{padding:36px 0;page-break-inside:avoid}
    .reveal{opacity:1 !important;transform:none !important}
  }

  .brandlogo{height:42px;width:auto;display:block}
  .coverlogo-img{width:150px;height:auto;display:block;margin-bottom:24px}
  .footlogo{height:30px;width:auto;display:block}

/* ============================================================
   WEB LAYER — additions for the ownexis.com site
   (the block above is the dossier design system, unchanged)
   ============================================================ */

/* accessibility */
.skip{position:absolute;left:-9999px;top:0;background:var(--gold);color:#fff;padding:10px 16px;z-index:999}
.skip:focus{left:8px;top:8px}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
img{max-width:100%}

/* ---------- top navigation ---------- */
.nav{position:sticky;top:0;z-index:100;background:rgba(32,32,40,.92);backdrop-filter:saturate(140%) blur(10px);border-bottom:1px solid rgba(255,255,255,.10)}
.nav-inner{max-width:var(--maxw);margin:0 auto;padding:0 40px;height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.nav a{text-decoration:none}
.nav-logo img{height:28px;width:auto;display:block}
.nav-links{display:flex;align-items:center;gap:26px}
.nav-links a{font-size:13px;letter-spacing:.13em;text-transform:uppercase;color:#cfccc4;transition:color .2s}
.nav-links a:hover{color:var(--gold)}
.nav-cta{border:1px solid var(--gold);color:var(--gold)!important;padding:9px 18px;letter-spacing:.13em}
.nav-cta:hover{background:var(--gold);color:#fff!important}
.lang{display:flex;gap:6px;align-items:center;font-size:12px;letter-spacing:.12em;color:#787570}
.lang a{color:#cfccc4}
.lang a:hover{color:var(--gold)}
.lang .on{color:var(--gold);font-weight:700}
.nav-toggle{display:none;background:none;border:1px solid rgba(255,255,255,.25);color:#efece5;padding:8px 12px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}

@media (max-width:980px){
  .nav-inner{padding:0 24px}
  .nav-toggle{display:block}
  .nav-links{position:absolute;top:68px;left:0;right:0;background:#1b1b22;border-bottom:1px solid rgba(255,255,255,.1);
    flex-direction:column;align-items:flex-start;gap:0;padding:8px 24px 20px;display:none}
  .nav-links.open{display:flex}
  .nav-links a{padding:13px 0;width:100%;border-bottom:1px solid rgba(255,255,255,.07)}
  .nav-cta{margin-top:14px;text-align:center;border-bottom:1px solid var(--gold)!important}
}

/* ---------- links & buttons ---------- */
.btn{display:inline-block;text-decoration:none;font-size:13px;letter-spacing:.14em;text-transform:uppercase;
  padding:15px 30px;border:1px solid var(--gold);color:var(--gold);transition:background .2s,color .2s}
.btn:hover{background:var(--gold);color:#fff}
.btn-solid{background:var(--gold);color:#fff}
.btn-solid:hover{background:var(--gold-deep);border-color:var(--gold-deep)}
.btn-row{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}
.contact-card .v a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(184,144,72,.5)}
.contact-card .v a:hover{color:var(--gold)}

/* ---------- photography in image frames ----------
   Drop a file in assets/img/photos/ and add:
   <div class="imgframe ar-hero"><img src="assets/img/photos/hotel.jpg" alt=""> ... </div>
   The caption/watermark hide automatically once an <img> is present. */
.imgframe img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}
.imgframe:has(img) .wm{display:none}
.imgframe:has(img) .cap .t{display:none}
.imgframe:has(img) .cap .d{font-size:13px;letter-spacing:.04em}

/* ---------- footer ---------- */
.foot-nav{display:flex;gap:20px;flex-wrap:wrap;margin-top:14px;font-size:13px}
.foot-nav a{color:#8f8c86;text-decoration:none}
.foot-nav a:hover{color:var(--gold)}
.foot-legal{border-top:1px solid rgba(255,255,255,.08);margin-top:28px;padding-top:18px;font-size:12px;color:#6f6c67;
  display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
.foot-legal a{color:#8f8c86;text-decoration:none}
.foot-legal a:hover{color:var(--gold)}

/* ---------- simple legal / text pages ---------- */
.page{padding:64px 0 78px}
.page h1{font-size:clamp(30px,4vw,44px);margin-bottom:8px}
.page h2{font-size:22px;margin:34px 0 10px}
.page p,.page li{font-size:16px;color:var(--ink-soft);max-width:74ch}
.page ul{padding-left:20px}

/* anchor offset under the sticky nav */
section[id],header[id]{scroll-margin-top:80px}

/* ============================================================
   WEB LAYER II — credibility blocks, contact form, modal
   ============================================================ */

/* ---------- founder / experience ---------- */
.founder{display:grid;grid-template-columns:.72fr 1.28fr;gap:52px;align-items:center}
.founder .name{font-family:var(--display);font-size:clamp(24px,3vw,32px);margin:0 0 6px}
.founder .role{font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
.founder .claim{font-family:var(--display);font-size:18px;color:#fff;border-left:3px solid var(--gold);padding-left:18px;margin:0 0 20px}
.founder p{font-size:15.5px;color:#c7c4bd}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.12);margin-top:30px}
.stat{background:#202028;padding:22px 18px;text-align:center}
.stat .n{font-family:var(--display);font-size:clamp(26px,3.4vw,34px);color:var(--gold);line-height:1}
.stat .l{font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:#a9a6a0;margin-top:10px;line-height:1.5}
.fnote{font-size:12.5px;color:#8f8c86;margin-top:16px}

/* ---------- track record ---------- */
.disclaimer{background:var(--gold-tint);border-left:3px solid var(--gold);padding:16px 20px;font-size:14.5px;color:var(--ink-soft);margin-bottom:34px}
.records{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line-soft);border:1px solid var(--line-soft)}
.record{background:var(--card);padding:26px 26px 28px}
.record h3{font-size:17.5px;margin-bottom:8px;line-height:1.25}
.record .meta{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-deep);margin-bottom:12px;line-height:1.6}
.record p{font-size:14.5px;color:var(--muted);margin:0}

/* ---------- references ---------- */
.refs{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.ref{border-top:2px solid var(--gold);padding-top:20px}
.ref .q{font-size:15px;color:#c7c4bd;margin:0 0 18px}
.ref .org{font-family:var(--display);font-size:18px;color:#fff;margin-bottom:4px}
.ref .who{font-size:13px;color:#a9a6a0}
.ref .when{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-top:8px}

/* ---------- contact form ---------- */
.form-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.14);padding:32px}
.form-card h3{font-size:19px;margin-bottom:6px;color:#fff}
.form-card .hint{font-size:13.5px;color:#a9a6a0;margin-bottom:22px}
.field{margin-bottom:16px}
.field label{display:block;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:7px}
.field input,.field textarea{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);color:#f4f2ec;
  font-family:var(--body);font-size:15px;padding:12px 14px;border-radius:0;transition:border-color .2s,background .2s}
.field textarea{min-height:118px;resize:vertical}
.field input::placeholder,.field textarea::placeholder{color:#7c7a75}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--gold);background:rgba(255,255,255,.09)}
.field input:invalid:not(:placeholder-shown){border-color:#b4553f}
.form-card button{width:100%;background:var(--gold);color:#fff;border:1px solid var(--gold);font-family:var(--body);
  font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:15px 20px;cursor:pointer;transition:background .2s}
.form-card button:hover{background:var(--gold-deep);border-color:var(--gold-deep)}
.form-card button[disabled]{opacity:.6;cursor:progress}
.form-legal{font-size:11.5px;color:#8f8c86;margin-top:14px;line-height:1.6}
.form-legal a{color:#a9a6a0}
.form-direct{margin-top:20px;padding-top:18px;border-top:1px solid rgba(255,255,255,.12);font-size:13.5px;color:#a9a6a0}
.form-direct a{color:#efece5;text-decoration:none;border-bottom:1px solid rgba(184,144,72,.6)}
.form-direct a:hover{color:var(--gold)}
.hp{position:absolute;left:-9999px;opacity:0;height:0;width:0}

/* ---------- thank-you modal ---------- */
.modal{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;padding:24px;
  background:rgba(20,20,26,.72);backdrop-filter:blur(4px)}
.modal.open{display:flex}
.modal-box{background:var(--paper);max-width:460px;width:100%;padding:44px 40px 36px;text-align:center;
  border-top:5px solid var(--gold);box-shadow:0 30px 80px rgba(0,0,0,.45);animation:pop .28s ease}
@keyframes pop{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.modal-box .mark{width:56px;height:56px;margin:0 auto 22px;border:1px solid var(--gold);display:flex;align-items:center;justify-content:center}
.modal-box h3{font-size:24px;margin-bottom:14px}
.modal-box p{font-size:15.5px;color:var(--ink-soft);margin:0 0 26px}
.modal-box button{background:var(--ink);color:#fff;border:0;font-family:var(--body);font-size:12.5px;letter-spacing:.16em;
  text-transform:uppercase;padding:14px 34px;cursor:pointer}
.modal-box button:hover{background:var(--gold-deep)}
@media (prefers-reduced-motion:reduce){.modal-box{animation:none}}

@media (max-width:900px){
  .founder{grid-template-columns:1fr;gap:30px}
  .stats{grid-template-columns:1fr 1fr}
  .records,.refs{grid-template-columns:1fr}
  .form-card{padding:26px 22px}
}
